    "When you get a question wrong it shows up here, with the correction.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Frage falsch hast, erscheint sie hier, mit der Korrektur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando falles una pregunta la encontrarás aquí, con la corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu te trompes sur une question, elle apparaît ici, avec la correction."
          }
        },
