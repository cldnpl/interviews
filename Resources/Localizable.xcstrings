        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra na App Store. Tente de novo."
          }
        }
      }
    },
    "We send a reminder at the time you prefer, only on days you haven't done the quiz yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir schicken eine Erinnerung zur Uhrzeit deiner Wahl, nur an Tagen ohne Quiz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te enviamos un recordatorio a la hora que prefieras, solo los días en que aún no has hecho el cuestionario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On t'envoie un rappel à l'heure que tu veux, seulement les jours où tu n'as pas encore fait le quiz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti mandiamo un promemoria all'ora che preferisci, solo nei giorni in cui non hai ancora fatto il quiz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um lembrete no horário que você preferir, só nos dias em que ainda não fez o quiz."
          }
        }
      }
    },
    "What you need every day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du jeden Tag brauchst."
          }
