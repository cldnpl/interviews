            "state": "translated",
            "value": "Ogni lezione, ogni domanda, su tutti e quattro i percorsi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada lição, cada pergunta, nas quatro trilhas."
          }
        }
