    "Buttons, lessons, questions and reminders all switch. Your progress stays as it is.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons, Lektionen, Fragen und Erinnerungen wechseln mit. Dein Fortschritt bleibt, wie er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambian los botones, las lecciones, las preguntas y los recordatorios. Tu progreso se queda igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons, les leçons, les questions et les rappels changent. Ta progression reste la même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiano bottoni, lezioni, domande e promemoria. I tuoi progressi restano come sono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Botões, lições, perguntas e lembretes mudam todos. O seu progresso fica como está."
          }
        }
      }
    },
