    "%lld days without missing one. This is how an interview gets easy.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giorni senza saltarne uno. È così che un colloquio diventa facile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld días sin fallar ninguno. Así es como una entrevista se vuelve fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jours sans en manquer un. C'est comme ça qu'un entretien devient facile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage ohne Unterbrechung. So wird ein Gespräch leicht."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld dias sem faltar nenhum. É assim que uma entrevista fica fácil."
          }
        }
      }
    },
