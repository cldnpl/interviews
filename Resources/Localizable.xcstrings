    "It renews by itself every month until you cancel it, from Settings on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verlängert sich jeden Monat selbst, bis du es in den iPhone-Einstellungen kündigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva solo cada mes hasta que lo canceles, desde los Ajustes del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se renouvelle tout seul chaque mois jusqu'à ce que tu l'annules, depuis les Réglages de l'iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova da sé ogni mese finché non lo disdici, dalle Impostazioni dell'iPhone."
