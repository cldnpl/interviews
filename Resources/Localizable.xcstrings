            "state": "translated",
            "value": "Les sujets où l'expérience se voit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I temi su cui si vede l'esperienza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os temas em que a experiência aparece."
          }
        }
      }
    },
    "Without Pro the daily questions stay on the Junior topics. With Pro they follow your rank, all the way to Staff.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Pro bleiben die Tagesfragen bei den Junior-Themen. Mit Pro folgen sie deinem Rang, bis Staff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin Pro las preguntas del día se quedan en los temas Junior. Con Pro siguen tu rango, hasta Staff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans Pro les questions du jour restent sur les sujets Junior. Avec Pro elles suivent ton rang, jusqu'à Staff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza Pro le domande del giorno restano sugli argomenti Junior. Con Pro seguono il tuo grado, fino a Staff."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem o Pro as perguntas do dia ficam nos tópicos Junior. Com o Pro elas seguem o seu nível, até Staff."
          }
        }
      }
    },
    "Without the subscription you keep all the Junior topics, forever, and five questions a day.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Abo bleiben dir alle Junior-Themen, dauerhaft, und fünf Fragen am Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin suscripción te quedan todos los temas Junior, para siempre, y cinco preguntas al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans abonnement il te reste tous les sujets Junior, pour toujours, et cinq questions par jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza abbonamento ti restano tutti gli argomenti Junior, per sempre, e cinque domande al giorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura você fica com todos os tópicos Junior, para sempre, e cinco perguntas por dia."
          }
        }
      }
    },
