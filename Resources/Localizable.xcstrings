    "Do today's quiz and the streak starts again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai il quiz di oggi e la serie riparte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz el test de hoy y la racha vuelve a empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais le quiz du jour et la série repart."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach das heutige Quiz und die Serie beginnt neu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça o quiz de hoje e a sequência recomeça."
          }
        }
      }
    },
    "Don't break the streak: 5 questions on %@ are waiting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterbrich die Serie nicht: 5 Fragen zu %@ warten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No rompas la serie: 5 preguntas de %@ te esperan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne casse pas la série : 5 questions sur %@ t'attendent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non spezzare la serie: 5 domande su %@ ti aspettano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não quebre a sequência: 5 perguntas de %@ esperam por você."
          }
        }
      }
    },
    "Done": {
      "localizations": {
