        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova sozinho todo mês até você cancelar, nos Ajustes do iPhone."
          }
        }
      }
    },
    "It's a symbolic price to support an independent developer and push me to keep making this better.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein symbolischer Preis, um eine unabhängige Entwicklerin zu unterstützen und mich anzutreiben, es immer besser zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un precio simbólico para apoyar a una desarrolladora independiente y empujarme a hacerlo cada vez mejor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est un prix symbolique pour soutenir une développeuse indépendante et me pousser à faire toujours mieux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È un prezzo simbolico per sostenere una sviluppatrice indipendente e spingermi a fare sempre meglio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É um preço simbólico para apoiar uma desenvolvedora independente e me empurrar a fazer sempre melhor."
          }
        }
      }
    },
