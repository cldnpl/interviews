    },
    "The harder topics are part of a subscription at %@ a month. It's a symbolic price to support an independent developer. You can look at it later, from your profile.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli argomenti più difficili fanno parte di un abbonamento da %@ al mese. È un prezzo simbolico per sostenere una sviluppatrice indipendente. Puoi guardarlo più tardi, dal profilo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los temas más difíciles son parte de una suscripción de %@ al mes. Es un precio simbólico para apoyar a una desarrolladora independiente. Puedes verlo más tarde, desde el perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sujets plus difficiles font partie d'un abonnement à %@ par mois. C'est un prix symbolique pour soutenir une développeuse indépendante. Tu peux le regarder plus tard, depuis le profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schwereren Themen gehören zu einem Abo für %@ im Monat. Ein symbolischer Preis, um eine unabhängige Entwicklerin zu unterstützen. Du kannst es später im Profil ansehen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tópicos mais difíceis fazem parte de uma assinatura de %@ por mês. É um preço simbólico para apoiar uma desenvolvedora independente. Você pode ver mais tarde, no perfil."
          }
        }
      }
    },
