    "By default the app follows your iPhone. If you prefer, you can fix it on light or on dark from the profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig folgt die App deinem iPhone. Wenn du willst, kannst du im Profil hell oder dunkel festlegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto la app sigue a tu iPhone. Si prefieres, desde el perfil puedes fijarla en claro o en oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut l'app suit ton iPhone. Si tu préfères, tu peux la fixer en clair ou en sombre depuis le profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di base l'app segue l'iPhone. Se preferisci, dal profilo puoi fissarla su chiaro o su scuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão o app segue o seu iPhone. Se preferir, no perfil você pode fixar em claro ou escuro."
          }
        }
